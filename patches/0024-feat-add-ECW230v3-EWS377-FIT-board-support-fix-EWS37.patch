diff --git a/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi b/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi
new file mode 100644
index 0000000000..916a184111
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
+/*
+ * Shared hardware for EnGenius AP-HK07 family (IPQ8072A):
+ *   EWS377AP v3, ECW230v3, EWS377-FIT
+ *
+ * All three share identical board hardware: same LEDs (GPIO 54/55/56),
+ * same reset button (GPIO 52), same ethernet (QCA8081 @ MDIO addr 28,
+ * 2.5GbE on ESS port 6 via uniphy2), same NAND (128k/2048, SMEM
+ * partitions), same WiFi (QCN5024 + QCN5054, board_id 0x290).
+ *
+ * GPIO/LED/PHY values confirmed from vendor device tree fdt@hk07
+ * extracted from stock firmware.
+ */
+
+/dts-v1/;
+
+#include "ipq8074.dtsi"
+#include "ipq8074-nss.dtsi"
+#include "ipq8074-hk-cpu.dtsi"
+#include "ipq8074-ess.dtsi"
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	aliases {
+		serial0 = &blsp1_uart5;
+		led-boot = &led_blue;
+		led-failsafe = &led_red;
+		led-running = &led_blue;
+		led-upgrade = &led_green;
+	};
+
+	chosen {
+		stdout-path = "serial0,115200n8";
+		bootargs-append = " ubi.block=0,rootfs root=/dev/ubiblock0_1";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_red: led-red {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_green: led-green {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_blue: led-blue {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+
+&blsp1_uart5 {
+	status = "okay";
+};
+
+&tlmm {
+	mdio_pins: mdio-pins {
+		mdc {
+			pins = "gpio68";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio {
+			pins = "gpio69";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+	pinctrl-0 = <&mdio_pins>;
+	pinctrl-names = "default";
+	reset-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+
+	qca8081_28: ethernet-phy@28 {
+		compatible = "ethernet-phy-id004d.d101";
+		reg = <28>;
+	};
+};
+
+&uniphy2 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			ethernet = <&edma>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <1000>;
+				full-duplex;
+			};
+		};
+
+		swport6: port@6 {
+			reg = <6>;
+			label = "lan";
+			phy-handle = <&qca8081_28>;
+			phy-mode = "2500base-x";
+			pcs-handle = <&uniphy2 0>;
+		};
+	};
+};
+
+&edma {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "qcom,smem-part";
+		};
+	};
+};
+
+&wifi {
+	status = "okay";
+	qcom,ath11k-fw-memory-mode = <1>;
+};
diff --git a/target/linux/qualcommax/dts/ipq8072-engenius-ecw230v3.dts b/target/linux/qualcommax/dts/ipq8072-engenius-ecw230v3.dts
new file mode 100644
index 0000000000..dd1d16388d
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8072-engenius-ecw230v3.dts
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
+/*
+ * EnGenius ECW230v3 — cloud-managed AP, product_id 0x011c
+ *
+ * No hardware access; candidate support based on firmware analysis.
+ * Stock firmware defaults to config@hk08 but contains an identical
+ * fdt@hk07 DTB — using config@hk07 here (same board hardware as
+ * EWS377AP v3). Community testers: if bootipq selects hk08, change
+ * DEVICE_DTS_CONFIG in ipq807x.mk.
+ */
+
+#include "ipq8072-engenius-ap-hk07.dtsi"
+
+/ {
+	model = "EnGenius ECW230v3";
+	compatible = "engenius,ecw230v3", "qcom,ipq8074";
+};
+
+&wifi {
+	qcom,ath11k-calibration-variant = "EnGenius-ECW230v3";
+};
diff --git a/target/linux/qualcommax/dts/ipq8072-engenius-ews377-fit.dts b/target/linux/qualcommax/dts/ipq8072-engenius-ews377-fit.dts
new file mode 100644
index 0000000000..2004bdd49c
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8072-engenius-ews377-fit.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
+/*
+ * EnGenius EWS377-FIT — FIT-controller managed AP, product_id 0x012c
+ *
+ * No hardware access; candidate support based on firmware analysis.
+ * Board data differs from EWS377AP v3 by only 56 bytes (0.04%).
+ */
+
+#include "ipq8072-engenius-ap-hk07.dtsi"
+
+/ {
+	model = "EnGenius EWS377-FIT";
+	compatible = "engenius,ews377-fit", "qcom,ipq8074";
+};
+
+&wifi {
+	qcom,ath11k-calibration-variant = "EnGenius-EWS377-FIT";
+};
