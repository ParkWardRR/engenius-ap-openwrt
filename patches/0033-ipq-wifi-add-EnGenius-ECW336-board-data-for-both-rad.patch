From d0e0e4e98b46c660f9aa0d5d147602f5931eb6f3 Mon Sep 17 00:00:00 2001
From: "Orsavio P. Delmare" <orsavio@delmare.lu>
Date: Fri, 20 Nov 2026 15:56:51 -0800
Subject: [PATCH 33/50] ipq-wifi: add EnGenius ECW336 board data for both radio
 sets

Taken from the unit's own stock firmware rather than generic reference data,
which matters here because qcn9000/senaoBDF.note shows Senao maintains their
own BDF for this board:

  board-engenius_ecw336.ipq8074  <- bdwlan.b290  (internal QCN5024/QCN5054)
  board-engenius_ecw336.qcn9074  <- qcn9000/bdwlan.ba4  (6 GHz QCN9074)

Both are keyed the way every in-tree file is (qmi-board-id=255 plus the
variant string from qcom,ath11k-calibration-variant), with the vendor's real
board ids carried as a second name on the same image in case ath11k's QMI
handshake reports those instead:

  bus=ahb,...,qmi-board-id=255,variant=EnGenius-ECW336  + qmi-board-id=656 (0x290)
  bus=pci,...,qmi-board-id=255,variant=EnGenius-ECW336  + qmi-board-id=164 (0xa4)

Note upstream linux-firmware already carries a generic
bus=pci,qmi-chip-id=0,qmi-board-id=164 entry, so the 6 GHz radio would come
up without this package -- just not on Senao's calibration.
---
 package/firmware/ipq-wifi/Makefile             |   2 ++
 .../files/board-engenius_ecw336.ipq8074        | Bin 0 -> 131252 bytes
 .../files/board-engenius_ecw336.qcn9074        | Bin 0 -> 131252 bytes
 target/linux/qualcommax/image/ipq807x.mk       |   3 ++-
 4 files changed, 4 insertions(+), 1 deletion(-)
 create mode 100644 package/firmware/ipq-wifi/files/board-engenius_ecw336.ipq8074
 create mode 100644 package/firmware/ipq-wifi/files/board-engenius_ecw336.qcn9074

diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index dc3fcf8f75..de1a0d4f16 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -53,6 +53,7 @@ ALLWIFIBOARDS:= \
 	edgecore_eap102 \
 	edimax_cax1800 \
 	engenius_ecw230v3 \
+	engenius_ecw336 \
 	engenius_ews377ap-v3 \
 	engenius_ews377-fit \
 	elecom_wrc-x3000gs2 \
@@ -262,6 +263,7 @@ $(eval $(call generate-ipq-wifi-package,dynalink_dl-wrx36,Dynalink DL-WRX36))
 $(eval $(call generate-ipq-wifi-package,edgecore_eap102,Edgecore EAP102))
 $(eval $(call generate-ipq-wifi-package,edimax_cax1800,Edimax CAX1800))
 $(eval $(call generate-ipq-wifi-package,engenius_ecw230v3,EnGenius ECW230v3))
+$(eval $(call generate-ipq-wifi-package,engenius_ecw336,EnGenius ECW336))
 $(eval $(call generate-ipq-wifi-package,engenius_ews377ap-v3,EnGenius EWS377AP v3))
 $(eval $(call generate-ipq-wifi-package,engenius_ews377-fit,EnGenius EWS377-FIT))
 $(eval $(call generate-ipq-wifi-package,elecom_wrc-x3000gs2,ELECOM WRC-X3000GS2))
