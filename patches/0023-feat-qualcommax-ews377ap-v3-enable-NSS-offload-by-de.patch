From 70ef5d44ed487b7b4b4aebd2ac0eea23a03ac3fd Mon Sep 17 00:00:00 2001
From: ParkWardRR <alfa147x@gmail.com>
Date: Fri, 2 Oct 2026 18:24:00 -0700
Subject: [PATCH 23/50] feat: qualcommax: ews377ap-v3: enable NSS offload by
 default
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add nss-tools to DEVICE_PACKAGES so the full NSS acceleration stack
(qca-nss-drv, qca-nss-ecm, bridge-mgr, PPPoE, SQM, Wi-Fi offload)
is included automatically when building for this board.

The device tree, kernel config, and init scripts already support NSS
on IPQ807x — this was the only missing piece. Hardware validation of
the six NSS gates (firmware load, EDMA binding, ECM offload, Wi-Fi
offload, SQM, stability) is pending UART testing.
---
 target/linux/qualcommax/image/ipq807x.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index e13d3090e3..489ffa2596 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -216,7 +216,7 @@ define Device/engenius_ews377ap-v3
 	# Name the config config@hk07 like the sibling ap-hk07 board
 	# (netgear_wax218) so bootipq finds it.
 	DEVICE_DTS_CONFIG := config@hk07
-	DEVICE_PACKAGES := ipq-wifi-engenius_ews377ap-v3
+	DEVICE_PACKAGES := ipq-wifi-engenius_ews377ap-v3 nss-tools
 	# Keep factory.ubi a BARE UBI (Device/UbiFit default) for the proven
 	# UART/u-boot and SSH+ubiformat install paths (raw-nand-writable / a
 	# valid ubiformat source; the earlier 0-byte-kernel-read failure was a
