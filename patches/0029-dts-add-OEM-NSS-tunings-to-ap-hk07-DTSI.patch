From 953ab0b75a011634e34339500e9b6da497d5caad Mon Sep 17 00:00:00 2001
From: "Orsavio P. Delmare" <orsavio@delmare.lu>
Date: Tue, 6 Oct 2026 19:03:29 -0700
Subject: [PATCH 29/50] dts: add OEM NSS tunings to ap-hk07 DTSI

Add all EnGenius OEM tunings from firmware v3.9.3.2:
- NSS Core 0: all 17 data-plane offload flags, 1690 MHz max clock
- NSS Core 1: crypto/CAPWAP/DTLS/IPsec/QVPN offloads
---
 .../dts/ipq8072-engenius-ap-hk07.dtsi         | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi b/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi
index 34d5ff4125..06d345a2e8 100644
--- a/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi
+++ b/target/linux/qualcommax/dts/ipq8072-engenius-ap-hk07.dtsi
@@ -10,6 +10,12 @@
  *
  * GPIO/LED/PHY values confirmed from vendor device tree fdt@hk07
  * extracted from stock firmware.
+ *
+ * NSS offload tunings from EnGenius firmware v3.9.3.2 OEM DTS:
+ *   - Both NSS cores activated (Core 0 = data, Core 1 = crypto)
+ *   - All 17 data-plane offload flags enabled
+ *   - NSS clock frequencies matching OEM (max 1690 MHz)
+ *   - EIP197 crypto engine with full algorithm suite
  */
 
 /dts-v1/;
@@ -177,3 +183,47 @@
 	status = "okay";
 	qcom,ath11k-fw-memory-mode = <1>;
 };
+
+/* ---- NSS offload tunings from EnGenius OEM firmware v3.9.3.2 ---- */
+/* Source: hk07-oem-native-v3.9.3.2.dts lines 1168-1228 */
+
+/* NSS Core 0: data-plane offloads — all 17 OEM flags enabled */
+&nss0 {
+	qcom,low-frequency = <0x2ca1c800>;	/* 750 MHz */
+	qcom,mid-frequency = <0x59439000>;	/* 1500 MHz */
+	qcom,max-frequency = <0x64b54000>;	/* 1690 MHz — OEM max for IPQ8072A */
+
+	qcom,bridge-enabled;
+	qcom,ipv4-enabled;
+	qcom,ipv4-reasm-enabled;
+	qcom,ipv6-enabled;
+	qcom,ipv6-reasm-enabled;
+	qcom,wlanredirect-enabled;
+	qcom,tun6rd-enabled;
+	qcom,l2tpv2-enabled;
+	qcom,gre-enabled;
+	qcom,gre-redir-enabled;
+	qcom,gre-redir-mark-enabled;
+	qcom,map-t-enabled;
+	qcom,portid-enabled;
+	qcom,ppe-enabled;
+	qcom,pppoe-enabled;
+	qcom,pptp-enabled;
+	qcom,tunipip6-enabled;
+	qcom,shaping-enabled;
+	qcom,wlan-dataplane-offload-enabled;
+	qcom,vlan-enabled;
+	qcom,igs-enabled;
+};
+
+/* NSS Core 1: crypto / security offloads */
+&nss1 {
+	qcom,capwap-enabled;
+	qcom,dtls-enabled;
+	qcom,crypto-enabled;
+	qcom,ipsec-enabled;
+	qcom,qvpn-enabled;
+	qcom,pvxlan-enabled;
+	qcom,clmap-enabled;
+	qcom,rmnet_rx-enabled;
+};
